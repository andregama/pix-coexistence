{
  "name": "systema-cdc-connector",
  "config": {
    "connector.class": "io.debezium.connector.sqlserver.SqlServerConnector",
    "database.hostname": "sqlserver",
    "database.port": "1433",
    "database.user": "sa",
    "database.password": "${file:/kafka/external-config/dbz-secrets.properties:database.password}",
    "database.names": "DB_SYSTEMA",
    "table.include.list": "DB_SYSTEMA.dbo.SpiRecepApiBacen,DB_SYSTEMA.dbo.SpiEnvioApiBacen",
    "database.server.name": "systema",
    "topic.prefix": "systema",
    "snapshot.mode": "initial",
    "snapshot.isolation.mode": "read_committed",

    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": false,

    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "spi.systema.cdc.dlq",
    "errors.deadletterqueue.topic.replication.factor": 1,
    "errors.deadletterqueue.context.headers.enable": true,

    "heartbeat.interval.ms": "5000",
    "poll.interval.ms": "500",

    "topic.creation.default.replication.factor": 1,
    "topic.creation.default.partitions": 3,
    "topic.creation.groups": "spi",
    "topic.creation.spi.include": "spi\\.systema\\.cdc",
    "topic.creation.spi.replication.factor": 1,
    "topic.creation.spi.partitions": 3,
    "topic.creation.spi.cleanup.policy": "delete",

    "transforms": "topicRoute",
    "transforms.topicRoute.type": "io.debezium.transforms.ByLogicalTableRouter",
    "transforms.topicRoute.topic.regex": "systema\\.DB_SYSTEMA\\.dbo\\.(SpiRecepApiBacen|SpiEnvioApiBacen)",
    "transforms.topicRoute.topic.replacement": "spi.systema.cdc",
    "transforms.topicRoute.key.enforce.uniqueness": "false"
  }
}
