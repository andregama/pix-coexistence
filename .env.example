# ── Local Development (docker-compose) ────────────────────────────────────────
SA_PASSWORD=Dev@Strong123

# ── Production Environment Variables ──────────────────────────────────────────
# ASP.NET Core reads these automatically. Double-underscore (__) maps to nested
# JSON keys. Set these in your deployment platform (Docker, Kubernetes, App Service).

# Database
ConnectionStrings__SqlServer=Server=prod-sql;Database=DB_COEXISTENCE;User Id=svc_coexistence;Password=CHANGE_ME;TrustServerCertificate=False;Encrypt=True;

# Redis
ConnectionStrings__Redis=prod-redis:6379,password=CHANGE_ME,ssl=true

# Kafka
Kafka__BootstrapServers=prod-kafka:9092

# Dinamo HSM
# Host: HSM hostname or IP (LocalDinamoSdkClient treats this as a PFX path in non-Production)
Dinamo__Host=hsm.internal
Dinamo__Port=4433
Dinamo__UserId=spi_signer
Dinamo__Password=CHANGE_ME
Dinamo__CertificateLabel=SPI_SIGNING_CERT
Dinamo__KeyLabel=SPI_SIGNING_KEY
Dinamo__SignMechanism=RSA_PKCS1_V1_5

# Orchestrator (non-Development only — StubOrchestratorClient is used in Development)
Orchestrator__BaseUrl=https://orchestrator.internal
Orchestrator__TimeoutSeconds=5
Orchestrator__ApiKey=CHANGE_ME

# mTLS — Bacen client certificate thumbprints (comma-separated SHA-1, colon-separated hex)
# Example: AA:BB:CC:DD:...
CertificateValidator__TrustedThumbprints__0=CHANGE_ME
CertificateValidator__ValidateChain=true

# Kestrel TLS server certificate (Production)
Kestrel__Certificates__Default__Path=/certs/server.pfx
Kestrel__Certificates__Default__Password=CHANGE_ME

# OpenTelemetry / Jaeger
Otel__Endpoint=http://jaeger:4317
